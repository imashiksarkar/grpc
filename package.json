{
  "name": "grpc",
  "module": "index.ts",
  "scripts": {
    "generate": "rm -rf ./generated/* && grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./generated --grpc_out=grpc_js:./generated --ts_out=grpc_js:./generated -I ./grpc/proto ./grpc/proto/helloworld.proto",
    "dev": "bun --watch ./server.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "grpc-tools": "^1.13.1",
    "grpc_tools_node_protoc_ts": "^5.3.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "google-protobuf": "^4.0.2"
  }
}
